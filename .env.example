APP_ENV=local
GATEWAY_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=shuihuo-killer-gateway
DATABASE_URL=sqlite:///data/shuihuo_killer.db
LLM_PROVIDER=mock
LLM_MODEL=example-model
LLM_BASE_URL=
LLM_API_PATH=/chat/completions
LLM_API_KEY=
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer
LLM_RESPONSE_CONTENT_PATH=choices.0.message.content
LLM_EXTRA_BODY_JSON=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RATE_LIMIT_ENABLED=false
LLM_RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Vision: required for screenshot-based exam solving (falls back to macOS OCR when false)
VISION_ENABLED=false
VISION_MODEL=
VISION_MAX_IMAGE_BYTES=4194304
# Memory: local project-repo recall + cross-interview long-term memory
MEMORY_ENABLED=false
MEMORY_REPO_ROOTS=
MEMORY_REPO_MAX_COMMITS=200
MEMORY_REPO_MAX_REPOS=20
MEMORY_RECALL_LIMIT=3
MEMORY_RECALL_MIN_SCORE=0.12
ASR_PROVIDER=stub
# Local streaming: ASR_PROVIDER=sherpa_onnx
# SHERPA_ASR_MODEL_DIR=models/sherpa-onnx-streaming-paraformer-bilingual-zh-en
# SHERPA_ASR_USE_INT8=true
# SHERPA_ASR_NUM_THREADS=2
# SHERPA_ASR_RULE2_MIN_TRAILING_SILENCE=0.8
ASR_BASE_URL=
ASR_API_PATH=/transcribe
ASR_API_KEY=
ASR_AUTH_HEADER=Authorization
ASR_AUTH_SCHEME=Bearer
ASR_TEXT_PATH=text
ASR_SPEAKER_PATH=speaker
ASR_START_MS_PATH=start_ms
ASR_END_MS_PATH=end_ms
ASR_IS_FINAL_PATH=is_final
ASR_CONFIDENCE_PATH=confidence
ASR_TIMEOUT_SECONDS=30
ASR_INTERVIEWER_CHANNELS=0,left,interviewer
ASR_CANDIDATE_CHANNELS=1,right,candidate
ALIYUN_ASR_API_KEY=
# ALIYUN_ASR_API_KEY must be a DashScope/Bailian API Key, not an NLS AppKey.
ALIYUN_ASR_MODEL=paraformer-realtime-v2
ALIYUN_ASR_SAMPLE_RATE=16000
ALIYUN_ASR_FORMAT=pcm
ALIYUN_ASR_LANGUAGE_HINTS=zh,en
ALIYUN_ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_TOKEN=
ALIYUN_NLS_ENDPOINT=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1
ALIYUN_NLS_SAMPLE_RATE=16000
ALIYUN_NLS_FORMAT=pcm
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_NLS_TOKEN_ENDPOINT=https://nls-meta.cn-shanghai.aliyuncs.com/
ALIYUN_NLS_TOKEN_REGION=cn-shanghai
SPEAKER_MODE=manual
DIALOGUE_SILENCE_CLOSE_MS=2500
PROBE_MIN_ANSWER_CHARS=20
PROBE_MIN_INTERVAL_MS=1000
# Deprecated compatibility options; v2 credibility probing does not read them.
PROBE_REQUIRE_TOPIC_MATCH=true
PROBE_TOPIC_KEYWORDS=项目,技术,架构,方案,决策,优化,性能,指标,数据,负责,实现,上线,故障,异常,成本,延迟,吞吐,FastAPI,LLM,Python
CHAIN_CRACK_PENALTY=8
CHAIN_HELD_UP_BONUS=3
QUESTION_MATCH_THRESHOLD=0.30
QUESTION_BANK_MIN=12
QUESTION_BANK_MAX=18
DEBUG_TEXT_INPUT_ENABLED=true
SPEAKER_DIARIZATION_PROVIDER=local
SPEAKER_DIARIZATION_BASE_URL=
SPEAKER_DIARIZATION_API_PATH=/diarize
SPEAKER_DIARIZATION_API_KEY=
SPEAKER_DIARIZATION_AUTH_HEADER=Authorization
SPEAKER_DIARIZATION_AUTH_SCHEME=Bearer
SPEAKER_DIARIZATION_SPEAKER_PATH=speaker
SPEAKER_DIARIZATION_TIMEOUT_SECONDS=10
AIGC_DETECTOR_PROVIDER=local
AIGC_DETECTOR_BASE_URL=
AIGC_DETECTOR_API_PATH=/detect
AIGC_DETECTOR_API_KEY=
AIGC_DETECTOR_AUTH_HEADER=Authorization
AIGC_DETECTOR_AUTH_SCHEME=Bearer
AIGC_DETECTOR_PROBABILITY_PATH=ai_generated_prob
AIGC_DETECTOR_FLAGGED_PATH=flagged
AIGC_DETECTOR_TIMEOUT_SECONDS=10
AIGC_AI_PROB_THRESHOLD=0.65
AIGC_TEMPLATE_SIMILARITY_THRESHOLD=0.45
REHEARSAL_THRESHOLD=0.55
SIGNAL_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=local
RATE_LIMIT_REQUESTS_PER_MINUTE=120
REDIS_RATE_LIMIT_PREFIX=shuihuo:rate_limit
OFFLINE_TASK_BACKEND=local
OFFLINE_TASK_EXECUTION=sync
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_QUEUE=shuihuo-offline
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_PREFIX=shuihuo
JD_VECTOR_BACKEND=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=shuihuo-killer
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
REPORT_DIR=data/reports
