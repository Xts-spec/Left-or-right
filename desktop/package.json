{
  "author": "haruinia",
  "name": "shuihuo-killer-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "左右：在题目旁边，找到另一种思路。半透明截图学习助手。",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.shuihuo.killer.cockpit",
    "productName": "左右",
    "files": [
      "main/**",
      "preload/**",
      "config.example.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web"
      },
      {
        "from": "native",
        "to": "native"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "实时转写面试对话需要麦克风权限。",
        "NSScreenCaptureUsageDescription": "笔试截图出题需要屏幕录制权限。"
      },
      "icon": "assets/icon.icns"
    }
  }
}
